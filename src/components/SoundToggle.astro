---
// The little moon: sound off (an outline) or on (a lit crescent with stars).
---
<button type="button" class="moon" data-sound-toggle aria-pressed="false" title="Sound">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path class="crescent" d="M15.5 3.6a8.6 8.6 0 1 0 4.9 14.6A7.1 7.1 0 0 1 15.5 3.6Z" />
    <path class="spark s1" d="M19 4.2l.5 1.3 1.3.5-1.3.5-.5 1.3-.5-1.3-1.3-.5 1.3-.5Z" />
    <path class="spark s2" d="M21.6 9.6l.3.8.8.3-.8.3-.3.8-.3-.8-.8-.3.8-.3Z" />
  </svg>
  <span class="visually-hidden" data-sound-label>Turn sound on</span>
</button>

<style>
  .moon { width: 2.2rem; height: 2.2rem; display: grid; place-items: center; padding: 0; border: 0; background: none; color: var(--ink); cursor: pointer; border-radius: 50%; transition: background .4s; }
  .moon:hover { background: rgba(140, 108, 53, .1); }
  svg { width: 1.25rem; height: 1.25rem; overflow: visible; }
  .crescent { fill: transparent; stroke: currentColor; stroke-width: 1.2; transition: fill .6s, stroke .6s; }
  .spark { fill: var(--gilt); opacity: 0; transform-origin: center; transform-box: fill-box; transform: scale(.2); transition: opacity .5s, transform .7s cubic-bezier(.2, .9, .3, 1.4); }
  .moon[aria-pressed="true"] .crescent { fill: var(--gilt); stroke: var(--gilt); filter: drop-shadow(0 0 4px rgba(220, 188, 124, .7)); }
  .moon[aria-pressed="true"] .spark { opacity: 1; transform: scale(1); }
  .moon[aria-pressed="true"] .s2 { transition-delay: .12s; animation: twinkle 2.6s ease-in-out 1s infinite; }
  @keyframes twinkle { 50% { opacity: .3; } }
</style>

<script>
  import { setSound, soundOn, onSoundChange } from '../scripts/sound.js';
  const sync = (on: boolean) => document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]').forEach((b) => {
    b.setAttribute('aria-pressed', String(on));
    b.querySelector('[data-sound-label]')!.textContent = on ? 'Turn sound off' : 'Turn sound on';
    b.title = on ? 'Sound on' : 'Sound off';
  });
  onSoundChange(sync); sync(soundOn());
  document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]').forEach((b) => b.addEventListener('click', () => setSound(!soundOn())));
</script>
