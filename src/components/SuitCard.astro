---
// A project's own card face, drawn in the manner of the 1909 Rider-Waite deck:
// white border, black keyline, a flat-coloured scene with bold outlines, and the title in a banner below.
interface Props { name: string; numeral: string; emblem?: string; sky?: string; title?: string }
const { name, numeral, emblem = 'sun', sky = 'yellow', title } = Astro.props;
const SKY: Record<string, string> = { yellow: '#f2cf3a', blue: '#9cc9e6', grey: '#c2bdb5', dawn: '#f7c993' };
const INK = '#141414', Y = '#f6d649', G = '#6fa04a', G2 = '#4f8237', STONE = '#cbc5bb', BROWN = '#9c6b3c', BLUE = '#5d9cd0', RED = '#c8392b';
const label = `${name.toUpperCase()}.`;
const rays = Array.from({ length: 16 }, (_, i) => (i / 16) * Math.PI * 2);
const star = (cx: number, cy: number, r: number) =>
  Array.from({ length: 16 }, (_, i) => { const a = (i / 16) * Math.PI * 2 - Math.PI / 2, q = i % 2 ? r * .4 : r; return `${(cx + Math.cos(a) * q).toFixed(1)},${(cy + Math.sin(a) * q).toFixed(1)}`; }).join(' ');
---
<svg class="suit-card" viewBox="0 0 300 500" role="img" aria-label={title ? `${name}, the card for ${title}` : name}>
  <rect width="300" height="500" rx="12" fill="#fdfcf8" />
  <clipPath id={`scene-${numeral}-${emblem}`}><rect x="19" y="19" width="262" height="396" /></clipPath>
  <g clip-path={`url(#scene-${numeral}-${emblem})`} stroke={INK} stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round">
    <rect x="19" y="19" width="262" height="396" fill={SKY[sky] ?? SKY.yellow} stroke="none" />

    {emblem === 'sun' && <>
      {rays.map((a, i) => i % 2
        ? <path d={`M${150 + Math.cos(a) * 62} ${170 + Math.sin(a) * 62} q ${Math.cos(a + .5) * 12} ${Math.sin(a + .5) * 12} ${Math.cos(a) * 22} ${Math.sin(a) * 22} t ${Math.cos(a) * 22} ${Math.sin(a) * 22}`} fill="none" />
        : <line x1={150 + Math.cos(a) * 62} y1={170 + Math.sin(a) * 62} x2={150 + Math.cos(a) * 112} y2={170 + Math.sin(a) * 112} />)}
      <circle cx="150" cy="170" r="54" fill="#fbe58a" />
      <path d="M19 345 Q90 300 165 338 T281 325 V420 H19Z" fill={G} />
      <path d="M19 375 Q120 345 200 372 T281 365 V420 H19Z" fill={G2} />
    </>}

    {emblem === 'tower' && <>
      <path d="M50 420 L78 355 L118 334 L188 338 L228 362 L252 420Z" fill={BROWN} />
      <path d="M95 360 l18 -8 M170 352 l20 10 M120 390 l25 -6" fill="none" />
      <rect x="124" y="150" width="52" height="190" fill={STONE} />
      {[170, 188, 206, 224, 242, 260, 278, 296, 314].map((y) => <line x1="124" y1={y} x2="176" y2={y} stroke-width="1.2" />)}
      <rect x="143" y="182" width="14" height="22" fill={Y} /><rect x="143" y="236" width="14" height="22" fill={Y} /><rect x="143" y="290" width="14" height="22" fill={Y} />
      <path d="M118 150 L182 150 L180 124 L168 138 L160 116 L150 134 L140 116 L132 138 L120 124Z" fill={Y} />
      <path d="M60 80 l6 14 14 6 -14 6 -6 14 -6 -14 -14 -6 14 -6Z M232 110 l4 9 9 4 -9 4 -4 9 -4 -9 -9 -4 9 -4Z" fill="#fff" stroke-width="1.6" />
    </>}

    {emblem === 'bridge' && <>
      <path d="M19 250 L70 190 L110 230 L160 170 L215 235 L250 205 L281 240 V300 H19Z" fill="#9aa7b4" />
      <path d="M150 182 l10 -12 14 18 M60 202 l10 -12 10 14" fill="none" stroke="#fff" stroke-width="2" />
      <rect x="19" y="330" width="262" height="90" fill={BLUE} />
      {[350, 372, 394].map((y) => <path d={`M30 ${y} q12 -6 24 0 t24 0 M120 ${y + 6} q12 -6 24 0 t24 0 M200 ${y} q12 -6 24 0 t24 0`} fill="none" stroke-width="1.6" />)}
      <path d="M19 300 L60 300 L72 340 L19 345Z" fill={G} />
      <path d="M281 300 L240 300 L228 340 L281 345Z" fill={G} />
      <path d="M40 300 L260 300 L260 318 Q150 238 40 318Z" fill={STONE} />
      <path d="M40 286 H260 M40 300 V286 M78 300 V286 M116 300 V286 M154 300 V286 M192 300 V286 M230 300 V286 M260 300 V286" fill="none" stroke-width="2" />
    </>}

    {emblem === 'key' && <>
      <rect x="19" y="350" width="262" height="70" fill={STONE} />
      <path d="M19 350 H281" fill="none" />
      <g transform="rotate(-38 150 210)">
        <circle cx="96" cy="210" r="36" fill={Y} />
        <circle cx="96" cy="210" r="14" fill={SKY[sky] ?? SKY.yellow} />
        <rect x="128" y="201" width="120" height="18" rx="3" fill={Y} />
        <path d="M208 219 v22 h12 v-22 M228 219 v30 h12 v-30" fill={Y} />
      </g>
      <polygon points={star(66, 80, 12)} fill="#fff" stroke-width="1.6" />
      <polygon points={star(236, 96, 9)} fill="#fff" stroke-width="1.6" />
      <polygon points={star(224, 300, 7)} fill="#fff" stroke-width="1.6" />
    </>}

    {emblem === 'sprout' && <>
      <circle cx="150" cy="330" r="80" fill="#fbe58a" />
      <path d="M19 330 Q150 300 281 330 V420 H19Z" fill={BROWN} />
      <path d="M40 360 l12 -4 M220 350 l14 5 M120 380 l16 -2" fill="none" stroke-width="1.6" />
      <path d="M150 322 C148 280 160 240 150 190" fill="none" stroke={G2} stroke-width="5" />
      <path d="M150 322 C148 280 160 240 150 190" fill="none" />
      <ellipse cx="128" cy="262" rx="22" ry="10" transform="rotate(-25 128 262)" fill={G} />
      <ellipse cx="174" cy="240" rx="24" ry="10" transform="rotate(22 174 240)" fill={G} />
      <ellipse cx="132" cy="214" rx="18" ry="8" transform="rotate(-30 132 214)" fill={G} />
      <circle cx="150" cy="182" r="10" fill={RED} />
      <polygon points={star(70, 70, 10)} fill="#fff" stroke-width="1.6" />
    </>}

    {emblem === 'lantern' && <>
      <path d="M19 360 L80 320 L120 345 L170 300 L230 340 L281 315 V420 H19Z" fill="#fff" />
      <path d="M150 19 V92" fill="none" />
      <circle cx="150" cy="98" r="7" fill="none" />
      <path d="M118 128 L182 128 L168 106 L132 106Z" fill="#3a3a3a" />
      <rect x="122" y="128" width="56" height="96" fill="#2f2f2f" />
      <rect x="130" y="136" width="40" height="80" fill={Y} />
      <polygon points="150,148 166,184 134,184" fill="#fff" stroke-width="1.6" />
      <polygon points="150,200 166,164 134,164" fill="#fff" stroke-width="1.6" />
      <line x1="150" y1="136" x2="150" y2="216" stroke-width="1.6" />
      <path d="M116 224 H184 L176 240 H124Z" fill="#3a3a3a" />
    </>}
  </g>
  <rect x="16" y="16" width="268" height="468" fill="none" stroke={INK} stroke-width="3" />
  <line x1="16" y1="415" x2="284" y2="415" stroke={INK} stroke-width="3" />
  <rect x="19" y="418" width="262" height="63" fill="#ece9e2" />
  <text x="150" y="55" text-anchor="middle" font-family="Bodoni Moda, Georgia, serif" font-size="24" fill={INK} stroke={SKY[sky] ?? SKY.yellow} stroke-width="4" paint-order="stroke">{numeral}</text>
  <text x="150" y="461" text-anchor="middle" font-family="Bodoni Moda, Georgia, serif" font-size="27" letter-spacing="2" fill={INK}
    textLength={label.length > 13 ? 240 : undefined} lengthAdjust="spacingAndGlyphs">{label}</text>
</svg>

<style>
  .suit-card { display: block; width: 100%; height: auto; }
</style>
