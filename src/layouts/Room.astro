---
// A room: the page each card opens. The card is held on one side, the room's contents on the other.
import Base from './Base.astro';
import Index from '../components/Index.astro';
import HeldCard from '../components/HeldCard.astro';
import SoundToggle from '../components/SoundToggle.astro';
import { deck, cardById } from '../data/deck.js';
import { site } from '../data/site.js';
import { url } from '../scripts/url.js';

interface Props { card: string; title: string; intro?: string; pageTitle?: string; description?: string; wide?: boolean }
const { card: cardId, title, intro, pageTitle, description, wide = false } = Astro.props;
const card = cardById[cardId];
const next = deck[(deck.indexOf(card) + 1) % deck.length];
---
<Base title={pageTitle ?? card.inside} description={description ?? card.story} image={url(`cards/${card.file}.webp`)}>
  <canvas class="mist" data-mist aria-hidden="true"></canvas>

  <header class="top">
    <a class="mark" href={url('')}><b>{site.name}</b><span>Back to the deck</span></a>
    <div class="tools"><SoundToggle /><Index current={cardId} /></div>
  </header>

  <main class:list={['room', { wide }]} data-card={cardId}>
    <aside class="card-side">
      <div class="card-stick">
        <slot name="card">
          <HeldCard file={card.file} name={card.name} />
          <p class="card-caption"><span>{card.num}</span> {card.name}</p>
        </slot>
      </div>
    </aside>
    <div class="body">
      <p class="eyebrow">{card.name} · {card.inside}</p>
      <h1>{title}</h1>
      {intro && <p class="intro">{intro}</p>}
      <div class="content"><slot /></div>
    </div>
  </main>

  <footer class="foot">
    <a class="next" href={url(next.path)}>
      <span class="eyebrow">Turn the next card</span>
      <b>{next.name}</b><em>{next.inside}</em>
    </a>
  </footer>
</Base>

<style>
  .top {
    position: relative; z-index: 10; display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;
    padding-top: calc(env(safe-area-inset-top, 0px) + 22px); padding-left: var(--gutter); padding-right: var(--gutter-r);
    max-width: 78rem; margin: 0 auto;
  }
  .tools { display: flex; align-items: center; gap: 1rem; }
  .mark { display: grid; gap: .1rem; text-decoration: none; }
  .mark b { font: italic 500 1.5rem/1 var(--display); letter-spacing: -.01em; }
  .mark span { font: 400 .68rem/1.4 var(--ui); letter-spacing: .22em; text-transform: uppercase; color: var(--haze); }
  .mark:hover span { color: var(--gilt); }

  .room {
    max-width: 78rem; margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter-r); padding-block: clamp(2rem, 6vw, 4.5rem) 3rem;
    display: grid; grid-template-columns: minmax(11rem, 17rem) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); align-items: start;
  }
  .card-stick { position: sticky; top: 2.5rem; display: grid; gap: 1.1rem; }
  .card-caption { margin: 0; text-align: center; font: italic 400 1rem var(--display); color: var(--haze); }
  .card-caption span { color: var(--gilt); margin-right: .4rem; }
  .body { min-width: 0; display: grid; gap: 1.1rem; align-content: start; max-width: 44rem; }
  .room.wide .body { max-width: none; }
  h1 { margin: 0; font-style: italic; font-size: clamp(2.6rem, 6vw, 4.4rem); line-height: .98; letter-spacing: -.02em; }
  .intro { margin: 0; font: 400 1.2rem/1.55 var(--display); color: var(--haze); max-width: 36em; }
  .content { padding-top: 1.5rem; min-width: 0; }

  .foot { max-width: 78rem; margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter-r); padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 3rem); display: flex; justify-content: flex-end; }
  .next { display: grid; justify-items: end; gap: .2rem; text-decoration: none; padding-top: 1.4rem; border-top: 1px solid var(--hair); min-width: min(20rem, 100%); }
  .next b { font: italic 400 1.9rem/1.1 var(--display); transition: transform .5s cubic-bezier(.2, .7, .2, 1); }
  .next em { font-style: normal; color: var(--haze); font-size: .9rem; }
  .next:hover b { transform: translateX(-.4rem); }

  @media (max-width: 820px) {
    .room { grid-template-columns: 1fr; gap: 1.5rem; padding-top: 1.5rem; }
    .card-stick { position: static; grid-template-columns: 7.5rem 1fr; align-items: end; gap: 1rem; }
    .card-stick :global(.held) { max-width: 7.5rem; margin: 0; }
    .card-caption { text-align: left; }
  }
</style>

<script>
  import { startMist } from '../scripts/mist.js';
  import { markTurned } from '../scripts/progress.js';
  const c = document.querySelector<HTMLCanvasElement>('[data-mist]');
  if (c) startMist(c, { calm: 0.5 });
  const id = document.querySelector<HTMLElement>('.room')?.dataset.card;
  if (id) markTurned(id);
</script>
