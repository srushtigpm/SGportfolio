---
import { getCollection } from 'astro:content';
import Room from '../layouts/Room.astro';
import { site } from '../data/site.js';
const books = await getCollection('books');
// cloth colours for the spines and covers, chosen to sit quietly on pearl
const cloth = ['#6e2f3a', '#2f3f5c', '#6d7a5e', '#b08a46', '#5a3d5c', '#46545f', '#a8665e', '#3e5a55', '#7b5b3a'];
const sizes = books.map((b, i) => {
  let h = 0; for (const ch of b.data.title) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
  return { height: 13 + (h % 5) * 0.9, width: 2.4 + ((h >> 3) % 4) * 0.35, color: cloth[i % cloth.length] };
});
const statusText = { read: 'Read', reading: 'Reading now', quit: 'Put down, unfinished' };
---
<Room card="priestess" title="The shelf" intro="The books that rearranged my head. Pull one off the shelf, then turn its pages." wide>
  <div class="library">
    <div class="shelf" role="tablist" aria-label="Books">
      {books.map((b, i) => (
        <button
          type="button" role="tab" class:list={['spine', b.data.status]} data-book={b.id}
          aria-selected="false" aria-controls="table"
          style={`--h:${sizes[i].height}rem; --w:${sizes[i].width}rem; --c:${sizes[i].color}; --d:${i * 0.06}s`}
        >
          <span class="t">{b.data.title}</span>
          <span class="a">{b.data.author}</span>
        </button>
      ))}
    </div>
    <div class="ledge" aria-hidden="true"></div>

    <div class="table" id="table" role="tabpanel" aria-live="polite">
      <p class="table-hint" id="hint">Pull a book off the shelf.</p>
      <div class="book" id="book" tabindex="-1" hidden>
        <div class="block" aria-hidden="true"></div>
        <div class="base face"><div class="endpaper"></div></div>
        <div class="leaf" data-i="0"><div class="face front" data-slot="cover"></div><div class="face back" data-slot="inside"></div></div>
        <div class="leaf" data-i="1"><div class="face front" data-slot="note"></div><div class="face back" data-slot="line"></div></div>
        <div class="leaf" data-i="2"><div class="face front" data-slot="more"></div><div class="face back" data-slot="end"></div></div>
      </div>
      <div class="controls" id="controls" hidden>
        <button type="button" id="prev" aria-label="Previous page">Back a page</button>
        <button type="button" id="next" aria-label="Next page">Turn the page</button>
        <button type="button" id="putback">Put it back</button>
      </div>
    </div>

    {books.map((b, i) => (
      <template id={`tpl-${b.id}`} data-cloth={sizes[i].color}>
        <div data-slot="cover">
          <div class="cover-in">
            <svg class="emblem" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="14" fill="none" stroke="currentColor" stroke-width="1" /><path d="M23 11a9 9 0 1 0 0 18 7 7 0 1 1 0-18Z" fill="currentColor" /></svg>
            <h3>{b.data.title}</h3>
            <span class="rule"></span>
            <p>{b.data.author}</p>
          </div>
        </div>
        <div data-slot="inside">
          <div class="endpaper">
            <div class="plate"><span>Ex libris</span><b>{site.name.replace(/\.$/, '')}</b><em>{statusText[b.data.status]}</em></div>
          </div>
        </div>
        <div data-slot="note">
          <div class="page-in">
            <p class="kicker">Why it stayed</p>
            <p class="body">{b.data.note}</p>
            <span class="folio">1</span>
          </div>
        </div>
        <div data-slot="line">
          <div class="page-in quote">
            {b.data.line
              ? <><p class="kicker">A line I keep</p><blockquote>{b.data.line}</blockquote></>
              : <><p class="kicker">{b.data.title}</p><blockquote>{b.data.author}</blockquote></>}
            <span class="folio">2</span>
          </div>
        </div>
        <div data-slot="more">
          <div class="page-in">
            {b.data.thoughts
              ? <><p class="kicker">More thoughts</p><p class="body">{b.data.thoughts}</p></>
              : <><p class="kicker">{statusText[b.data.status]}</p><p class="body">That’s all I wrote in the margins of this one.</p></>}
            <span class="folio">3</span>
          </div>
        </div>
        <div data-slot="end">
          <div class="page-in fin"><span>Fin.</span></div>
        </div>
      </template>
    ))}

    <div class="no-js-notes">
      {books.map((b) => (
        <article class="note">
          <p class="status">{statusText[b.data.status]}</p>
          <h2>{b.data.title}</h2>
          <p class="author">{b.data.author}</p>
          <p>{b.data.note}</p>
          {b.data.line && <blockquote>{b.data.line}</blockquote>}
        </article>
      ))}
    </div>
  </div>
</Room>

<style>
  .library { max-width: 54rem; }

  /* ---------- Shelf ---------- */
  .shelf { display: flex; align-items: flex-end; gap: 3px; min-height: 17rem; overflow-x: auto; padding: 2.5rem .6rem 0; scrollbar-width: thin; }
  .spine {
    flex: none; width: var(--w); height: var(--h); position: relative; cursor: pointer; border: 0; padding: .9rem 0 .6rem;
    display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: .6rem;
    color: #f3ece0; border-radius: 3px 3px 1px 1px;
    background:
      linear-gradient(90deg, rgba(0,0,0,.28), rgba(255,255,255,.12) 22%, rgba(255,255,255,0) 45%, rgba(0,0,0,.18) 85%, rgba(0,0,0,.32)),
      linear-gradient(180deg, transparent 8%, rgba(214, 180, 112, .55) 8.4%, transparent 9.2%, transparent 90%, rgba(214, 180, 112, .55) 90.4%, transparent 91.2%),
      var(--c);
    box-shadow: 0 .3rem .6rem -.2rem rgba(43, 37, 48, .4);
    transform-origin: 50% 100%;
    transition: transform .7s cubic-bezier(.2, .8, .2, 1.1), box-shadow .7s, opacity .6s;
    animation: shelve .9s cubic-bezier(.2, .8, .2, 1) var(--d) both;
  }
  .spine.quit { transform: rotate(-5deg); margin-inline: .35rem .1rem; }
  .spine.reading::after { content: ""; position: absolute; bottom: -1.1rem; left: 50%; width: .4rem; height: 1.5rem; margin-left: -.2rem; background: #b33c3c; clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%); }
  .spine:hover { transform: translateY(-.6rem) rotate(-1.5deg); }
  .spine.quit:hover { transform: rotate(-7deg) translateY(-.5rem); }
  .spine.out { opacity: .14; transform: translateY(-.3rem); }
  .t, .a { writing-mode: vertical-rl; transform: rotate(180deg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-height: 72%; }
  .t { font: italic 400 .95rem/1 var(--display); }
  .a { font: 500 .52rem/1 var(--ui); letter-spacing: .16em; text-transform: uppercase; opacity: .8; max-height: 22%; }
  .ledge { height: 10px; border-radius: 2px; background: linear-gradient(180deg, #d9cdb8, #bba98b); box-shadow: 0 10px 18px -8px rgba(43, 37, 48, .45), inset 0 1px 0 rgba(255,255,255,.6); }

  /* ---------- Reading table ---------- */
  .table { --P: min(15.5rem, 44vw); position: relative; margin-top: 2.2rem; min-height: calc(var(--P) * 1.42 + 6rem); display: grid; place-items: center; perspective: 2200px; }
  .table-hint { position: absolute; font: italic 400 1.2rem var(--display); color: var(--haze); margin: 0; transition: opacity .5s; }
  .table.has-book .table-hint { opacity: 0; }
  .book {
    --ink-b: #2b2530;
    position: relative; width: calc(var(--P) * 2); height: calc(var(--P) * 1.42);
    transform-style: preserve-3d; container-type: inline-size; outline: none; touch-action: pan-y;
  }
  /* the book's shadow on the table (a blurred plane behind it; a filter on .book itself would flatten the 3D pages) */
  .book::before {
    content: ""; position: absolute; top: 5%; bottom: -5%; right: 1%; left: calc(50% * (1 - var(--open, 0)) + 1%);
    transform: translateZ(-6px); background: rgba(30, 24, 36, .38); filter: blur(22px); border-radius: 10px;
  }
  .leaf, .base, .block { position: absolute; top: 0; left: 50%; width: 50%; height: 100%; }
  .leaf { transform-origin: 0 50%; transform-style: preserve-3d; transform: rotateY(var(--a, 0deg)) translateZ(var(--z, 0px)); }
  .face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; overflow: hidden; border-radius: 0 3px 3px 0; }
  .face.back { transform: rotateY(180deg); border-radius: 3px 0 0 3px; }
  /* the paper darkens as a page lifts toward you, lit from the front */
  .leaf .face::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(40, 30, 20, .55), rgba(40, 30, 20, 0) 70%); opacity: var(--shade, 0); }
  .leaf .face.back::after { background: linear-gradient(270deg, rgba(40, 30, 20, .55), rgba(40, 30, 20, 0) 70%); }
  .block { transform: translateZ(-2px); background: var(--paper); border-radius: 0 3px 3px 0; box-shadow: 1px 0 0 #e2d8c5, 2px 0 0 #f2ebdd, 3px 0 0 #ddd2bd, 4px 1px 0 #efe6d4, 5px 1px 0 #d8ccb5; }
  .base { transform: translateZ(-1px); }

  /* pages */
  .book :global(.page-in) {
    position: absolute; inset: 0; display: flex; flex-direction: column; gap: .9em; padding: 13% 12% 14%;
    color: var(--ink-b); font-size: max(11px, 2.7cqi); line-height: 1.6; overflow: auto;
    background:
      linear-gradient(90deg, rgba(120, 95, 60, .16), rgba(120, 95, 60, 0) 12%),
      radial-gradient(120% 90% at 70% 40%, rgba(255, 255, 255, .5), rgba(255, 255, 255, 0)),
      var(--paper);
  }
  .book :global(.face.back .page-in) { background: linear-gradient(270deg, rgba(120, 95, 60, .16), rgba(120, 95, 60, 0) 12%), radial-gradient(120% 90% at 30% 40%, rgba(255, 255, 255, .5), rgba(255, 255, 255, 0)), var(--paper); }
  .book :global(.kicker) { margin: 0; font: 500 .7em/1.3 var(--ui); letter-spacing: .22em; text-transform: uppercase; color: #8c6c35; }
  .book :global(.body) { margin: 0; font-family: var(--display); font-size: 1.12em; }
  .book :global(.quote) { justify-content: center; }
  .book :global(blockquote) { margin: 0; font: italic 400 1.7em/1.3 var(--display); text-wrap: balance; }
  .book :global(.folio) { position: absolute; bottom: 6%; left: 0; right: 0; text-align: center; font: italic 400 .85em var(--display); color: #8c6c35; }
  .book :global(.fin) { align-items: center; justify-content: center; }
  .book :global(.fin span) { font: italic 400 2em var(--display); color: #8c6c35; }

  /* cover */
  .book :global([data-slot="cover"]), .book :global(.face.front[data-slot="cover"]) { background: none; }
  .book :global(.cover-in) {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .7em; padding: 14% 12%; text-align: center;
    color: #e9cf96; font-size: max(11px, 2.7cqi);
    background:
      repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, rgba(0,0,0,.05) 0 1px, transparent 1px 3px),
      linear-gradient(90deg, rgba(0,0,0,.35), rgba(0,0,0,0) 9%, rgba(255,255,255,.06) 11%, rgba(0,0,0,0) 14%),
      var(--cloth);
    box-shadow: inset 0 0 0 .6em var(--cloth), inset 0 0 0 calc(.6em + 1px) #c9a865, inset 0 0 0 calc(.9em + 1px) var(--cloth), inset 0 0 0 calc(.9em + 2px) rgba(201, 168, 101, .6);
  }
  .book :global(.cover-in h3) { margin: 0; font: italic 400 1.9em/1.1 var(--display); text-wrap: balance; text-shadow: 0 1px 0 rgba(0,0,0,.35); }
  .book :global(.cover-in p) { margin: 0; font: 500 .7em var(--ui); letter-spacing: .24em; text-transform: uppercase; }
  .book :global(.cover-in .rule) { width: 30%; height: 1px; background: currentColor; opacity: .7; }
  .book :global(.emblem) { width: 22%; }

  /* endpapers: marbled in the cover's colour */
  .book :global(.endpaper) {
    position: absolute; inset: 0; display: grid; place-items: center;
    background:
      radial-gradient(circle at 20% 25%, color-mix(in srgb, var(--cloth) 55%, transparent) 0 6%, transparent 7%),
      radial-gradient(circle at 70% 60%, color-mix(in srgb, var(--cloth) 45%, transparent) 0 9%, transparent 10%),
      radial-gradient(circle at 40% 80%, color-mix(in srgb, var(--cloth) 35%, transparent) 0 5%, transparent 6%),
      radial-gradient(circle at 85% 15%, color-mix(in srgb, var(--cloth) 40%, transparent) 0 4%, transparent 5%),
      repeating-radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--cloth) 18%, var(--paper)) 0 .6em, var(--paper) .6em 1.2em);
  }
  .book :global(.plate) {
    display: grid; justify-items: center; gap: .35em; padding: 1.2em 1.6em; background: var(--paper); color: var(--ink-b);
    box-shadow: 0 0 0 1px #c9a865, 0 0 0 4px var(--paper), 0 0 0 5px rgba(201, 168, 101, .6); font-size: max(10px, 2.4cqi);
  }
  .book :global(.plate span) { font: 500 .65em var(--ui); letter-spacing: .26em; text-transform: uppercase; color: #8c6c35; }
  .book :global(.plate b) { font: italic 400 1.6em/1 var(--display); }
  .book :global(.plate em) { font: italic 400 .9em var(--display); color: #6a6370; }

  .controls { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem 1.4rem; margin-top: 1.6rem; }
  .controls button { background: none; border: 0; border-bottom: 1px solid var(--hair); padding: .35rem 0; cursor: pointer; color: var(--haze); font: 400 .7rem var(--ui); letter-spacing: .18em; text-transform: uppercase; }
  .controls button:hover { color: var(--ink); }
  .controls button:disabled { opacity: .35; }

  .no-js-notes { display: none; margin-top: 2rem; gap: 2rem; }
  :global(html:not(.js)) .no-js-notes { display: grid; }
  :global(html:not(.js)) .table { display: none; }
  .note h2 { margin: 0; font: italic 400 1.8rem/1.1 var(--display); }
  .note p { margin: .3rem 0 0; }
  .note .status { font: 500 .66rem var(--ui); letter-spacing: .22em; text-transform: uppercase; color: var(--gilt); }
  .note blockquote { margin: .6rem 0 0; padding-left: 1rem; border-left: 1px solid var(--gilt-soft); font: italic 400 1.2rem var(--display); color: var(--haze); }

  @keyframes shelve { from { opacity: 0; transform: translateY(-30px); } }
</style>

<script>
  import { play } from '../scripts/sound.js';

  const table = document.getElementById('table')!, book = document.getElementById('book')!, hint = document.getElementById('hint')!;
  const controls = document.getElementById('controls')!, prevBtn = document.getElementById('prev') as HTMLButtonElement, nextBtn = document.getElementById('next') as HTMLButtonElement;
  const spines = [...document.querySelectorAll<HTMLButtonElement>('.spine')];
  const leafEls = [...book.querySelectorAll<HTMLElement>('.leaf')];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Spring = { x: number; v: number; t: number };
  const leaves: (Spring & { held: boolean })[] = leafEls.map(() => ({ x: 0, v: 0, t: 0, held: false }));
  const fly: Spring = { x: 0, v: 0, t: 0 };     // 0 = on the shelf, 1 = on the table
  let from = { dx: 0, dy: 0, scale: .2 };
  let current: string | null = null, currentSpine: HTMLButtonElement | null = null;
  let closing: (() => void) | null = null, openedCover = false;

  function fill(id: string) {
    const tpl = document.getElementById(`tpl-${id}`) as HTMLTemplateElement;
    book.style.setProperty('--cloth', tpl.dataset.cloth!);
    tpl.content.querySelectorAll<HTMLElement>('[data-slot]').forEach((src) => {
      const dst = book.querySelector<HTMLElement>(`.face[data-slot="${src.dataset.slot}"]`)!;
      dst.replaceChildren(...[...src.childNodes].map((n) => n.cloneNode(true)));
    });
    const end = book.querySelector<HTMLElement>('.base')!;
    end.replaceChildren(Object.assign(document.createElement('div'), { className: 'endpaper' }));
  }

  function pull(spine: HTMLButtonElement, auto = false) {
    const id = spine.dataset.book!;
    if (current === id) { putBack(); return; }
    if (current) { putBack(() => pull(spine, auto)); return; }
    current = id; currentSpine = spine; openedCover = false;
    fill(id);
    book.hidden = false; controls.hidden = false; table.classList.add('has-book');
    spines.forEach((s) => s.setAttribute('aria-selected', String(s === spine)));
    spine.classList.add('out');
    // fly from the spine's place on the shelf to the middle of the table
    const sr = spine.getBoundingClientRect(), tr = table.getBoundingClientRect();
    from = { dx: sr.left + sr.width / 2 - (tr.left + tr.width / 2), dy: sr.top + sr.height / 2 - (tr.top + tr.height / 2), scale: Math.max(.15, sr.height / book.offsetHeight) };
    leaves.forEach((l) => { l.x = 0; l.v = 0; l.t = 0; });
    fly.x = still ? 1 : 0; fly.v = 0; fly.t = 1;
    play('flick');
    if (!auto) book.focus({ preventScroll: true });
  }

  function putBack(then?: () => void) {
    if (!current) { then?.(); return; }
    leaves.forEach((l, i) => { if (l.t !== 0) setTimeout(() => { l.t = 0; }, (leaves.length - 1 - i) * 120); });
    closing = () => {
      fly.t = 0;
      const wait = () => {
        if (fly.x > .04 && !still) { requestAnimationFrame(wait); return; }
        book.hidden = true; controls.hidden = true; table.classList.remove('has-book');
        currentSpine?.classList.remove('out'); spines.forEach((s) => s.setAttribute('aria-selected', 'false'));
        current = null; currentSpine = null;
        then?.();
      };
      wait();
    };
  }

  // turning: the top page on the right goes left, or the top page on the left comes back
  const topRight = () => leaves.findIndex((l) => l.t === 0);
  const topLeft = () => { for (let i = leaves.length - 1; i >= 0; i--) if (leaves[i].t === -180) return i; return -1; };
  function turnNext() { const i = topRight(); if (i >= 0) { leaves[i].t = -180; play('page'); } }
  function turnBack() { const i = topLeft(); if (i >= 0) { leaves[i].t = 0; play('page'); } }

  spines.forEach((s, i) => {
    s.addEventListener('click', () => pull(s));
    s.addEventListener('keydown', (e) => {
      const k = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (k) { e.preventDefault(); spines[(i + k + spines.length) % spines.length].focus(); }
    });
  });
  nextBtn.addEventListener('click', turnNext);
  prevBtn.addEventListener('click', turnBack);
  document.getElementById('putback')!.addEventListener('click', () => putBack());
  book.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') turnNext();
    if (e.key === 'ArrowLeft') turnBack();
    if (e.key === 'Escape') putBack();
  });

  // drag a page by its edge: the page follows your finger and keeps its momentum when you let go
  let drag: { i: number; startX: number; lastA: number; lastT: number; vel: number; moved: boolean } | null = null;
  const spineX = () => { const r = book.getBoundingClientRect(); return r.left + r.width / 2; };
  book.addEventListener('pointerdown', (e) => {
    if (fly.x < .9) return;
    const right = e.clientX > spineX();
    const i = right ? topRight() : topLeft();
    if (i < 0) return;
    drag = { i, startX: e.clientX, lastA: leaves[i].x, lastT: performance.now(), vel: 0, moved: false };
    leaves[i].held = true;
    book.setPointerCapture(e.pointerId);
  });
  book.addEventListener('pointermove', (e) => {
    if (!drag) return;
    if (Math.abs(e.clientX - drag.startX) > 5) drag.moved = true;
    if (!drag.moved) return;
    const P = book.offsetWidth / 2;
    const rel = Math.max(-1, Math.min(1, (e.clientX - spineX()) / P));
    const a = -Math.acos(rel) * 180 / Math.PI;
    const now = performance.now(), dt = Math.max(.008, (now - drag.lastT) / 1000);
    drag.vel = drag.vel * .5 + ((a - drag.lastA) / dt) * .5;
    drag.lastA = a; drag.lastT = now;
    leaves[drag.i].x = a; leaves[drag.i].v = 0;
  });
  const release = (e: PointerEvent) => {
    if (!drag) return;
    const l = leaves[drag.i], wasLeft = l.t === -180;
    l.held = false;
    if (!drag.moved) {
      if (e.clientX > spineX()) turnNext(); else turnBack();
    } else {
      l.v = Math.max(-900, Math.min(900, drag.vel));
      l.t = drag.vel < -250 ? -180 : drag.vel > 250 ? 0 : (l.x < -90 ? -180 : 0);
      if ((l.t === -180) !== wasLeft) play('page');
    }
    drag = null;
  };
  book.addEventListener('pointerup', release);
  book.addEventListener('pointercancel', release);

  // ---------- Animation ----------
  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min((now - last) / 1000, 1 / 30); last = now;
    if (current) {
      fly.v += (60 * (fly.t - fly.x) - 12 * fly.v) * dt; fly.x += fly.v * dt;
      if (still) fly.x = fly.t;
      if (!openedCover && fly.x > .9 && fly.t === 1) { openedCover = true; setTimeout(() => { if (current && leaves[0].t === 0) { leaves[0].t = -180; play('page'); } }, 250); }
      leaves.forEach((l) => {
        if (l.held) return;
        l.v += (110 * (l.t - l.x) - 13 * l.v) * dt; l.x += l.v * dt;
        if (still) { l.x = l.t; l.v = 0; }
      });
      if (closing && leaves.every((l) => l.t === 0 && l.x > -3)) { const c = closing; closing = null; c(); }

      const P = book.offsetWidth / 2;
      const open = Math.min(1, Math.max(0, -leaves[0].x / 180));
      const s = Math.max(0, fly.x), inv = 1 - Math.min(1, s);
      const scale = from.scale + (1 - from.scale) * Math.min(1, s);
      // the closed book is just its right half, so slide it left to keep it centred until it opens
      const shift = -P / 2 * (1 - open);
      book.style.transform = `translate(${from.dx * inv}px, ${from.dy * inv}px) translateX(${shift}px) rotateY(${-85 * inv}deg) rotateX(${12 * inv}deg) scale(${scale})`;
      book.style.opacity = s * 3 >= 1 ? '' : String(Math.max(0, s * 3)); // opacity below 1 flattens 3D, so clear it once arrived
      book.style.setProperty('--open', String(open));
      leaves.forEach((l, i) => {
        const el = leafEls[i], a = Math.max(-180, Math.min(0, l.x));
        el.style.setProperty('--a', `${l.x}deg`);
        el.style.setProperty('--shade', String(Math.sin(-a * Math.PI / 180) * .55));
        // in 3D, stacking comes from depth: lift each page a hair toward the viewer on whichever side it lies
        el.style.setProperty('--z', `${a > -90 ? (leaves.length - i) * .7 : -(i + 1) * .7}px`);
      });
      prevBtn.disabled = topLeft() < 0; nextBtn.disabled = topRight() < 0;
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);

  // arrive with the first book already off the shelf, so the room is alive at a glance
  setTimeout(() => { if (!current && spines[0]) pull(spines[0], true); }, still ? 0 : 700);
  void hint;
</script>
