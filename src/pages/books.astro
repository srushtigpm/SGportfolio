---
import { getCollection } from 'astro:content';
import Room from '../layouts/Room.astro';
import { shelvesFor, statusText, UNSORTED } from '../data/shelves.js';
import { url } from '../scripts/url.js';

const books = (await getCollection('books')).map((b) => ({ id: b.id, ...b.data }));
// shelves are your categories, in the order they first appear in the sheet; unsorted books go last
const categories = [...new Set(books.map((b) => b.category))].sort((a, b) => Number(a === UNSORTED) - Number(b === UNSORTED));
const shelves = shelvesFor(categories);

const count = (st: string[]) => books.filter((b) => st.includes(b.status)).length;
const filters = [
  { id: 'all', label: 'Everything', statuses: ['reading', 'next', 'read', 'quit', 'toread'] },
  { id: 'reading', label: 'Reading now', statuses: ['reading'] },
  { id: 'next', label: 'Up next', statuses: ['next'] },
  { id: 'read', label: 'Read', statuses: ['read', 'quit'] },
  { id: 'toread', label: 'Reading list', statuses: ['toread'] },
].map((f) => ({ ...f, n: count(f.statuses) }));
const data = { books, shelves, filters, statusText, thumbs: url('cards/thumbs/') };
---
<Room card="priestess" title="The bookcase" intro={`${books.length} books on ${shelves.length} shelves. Each shelf is kept by a tarot card. Take a book down to read what it’s about.`} wide>
  <div class="library">
    <div class="bar">
      <div class="pills" role="radiogroup" aria-label="Show">
        {filters.map((f, i) => (
          <button type="button" role="radio" class="pill" data-filter={f.id} aria-checked={i === 0 ? 'true' : 'false'}>{f.label} <span>{f.n}</span></button>
        ))}
      </div>
      <div class="tools">
        <label class="field"><span class="visually-hidden">Go to a shelf</span>
          <select id="jump">
            <option value="">Go to a shelf…</option>
            {shelves.map((s) => <option value={s.category}>{s.category}</option>)}
          </select>
        </label>
        <label class="field"><span class="visually-hidden">Find a book</span><input id="find" type="search" placeholder="Find a title or author" autocomplete="off" /></label>
      </div>
    </div>
    <p class="key"><i class="k-ribbon" aria-hidden="true"></i> Reading now <i class="k-slip" aria-hidden="true"></i> Up next</p>

    <div class="case" id="case"></div>
    <p class="empty" id="empty" hidden>No books match that.</p>

    <dialog class="detail" id="detail" aria-labelledby="d-title">
      <div class="sheet">
        <button type="button" class="x" id="d-close" aria-label="Put the book back">×</button>
        <div class="stage" id="d-stage">
          <div class="book3d" id="d-book">
            <div class="f front"><div class="cover"><span class="orn" aria-hidden="true"></span><b id="d-ctitle"></b><span class="rule"></span><em id="d-cauthor"></em></div></div>
            <div class="f back"></div>
            <div class="f spine3"><span id="d-stitle"></span></div>
            <div class="f pages"></div>
            <div class="f top"></div>
          </div>
        </div>
        <div class="info">
          <p class="shelfline"><img id="d-card" alt="" width="240" height="400" /><span><b id="d-cat"></b><em id="d-keeper"></em></span></p>
          <h2 id="d-title"></h2>
          <p class="author" id="d-author"></p>
          <p class="chip" id="d-status"></p>
          <p class="about" id="d-about"></p>
          <blockquote id="d-line" hidden></blockquote>
          <p class="note" id="d-note" hidden></p>
          <div class="nav">
            <button type="button" id="d-prev">← Previous</button>
            <button type="button" id="d-next">Next →</button>
          </div>
        </div>
      </div>
    </dialog>

    <script is:inline type="application/json" id="books-data" set:html={JSON.stringify(data)}></script>

    <div class="no-js">
      {shelves.map((s) => (
        <section>
          <h2>{s.category}</h2>
          <ul>{books.filter((b) => b.category === s.category).map((b) => <li><b>{b.title}</b>, {b.author} <em>{statusText[b.status]}</em>{b.about && <> — {b.about}</>}</li>)}</ul>
        </section>
      ))}
    </div>
  </div>
</Room>

<style>
  .library { max-width: 58rem; }

  /* ---------- Controls ---------- */
  .bar { display: flex; flex-wrap: wrap; gap: .8rem 1.2rem; align-items: center; justify-content: space-between; margin-bottom: .6rem; }
  .pills { display: flex; flex-wrap: wrap; gap: .4rem; }
  .pill { border: 1px solid var(--hair); background: none; color: var(--ink); border-radius: 99px; padding: .4rem .8rem; font: 400 .74rem var(--ui); letter-spacing: .04em; cursor: pointer; transition: background .3s, color .3s; }
  .pill span { color: var(--gilt); margin-left: .2rem; font-variant-numeric: tabular-nums; }
  .pill[aria-checked="true"] { background: var(--ink); color: var(--pearl); border-color: var(--ink); }
  .pill[aria-checked="true"] span { color: var(--gilt-soft); }
  .tools { display: flex; flex-wrap: wrap; gap: .5rem; }
  .field select, .field input { padding: .5rem .9rem; border-radius: 99px; border: 1px solid var(--hair); background: var(--veil); color: var(--ink); font: 400 .85rem var(--ui); max-width: 100%; }
  .field input { width: 14rem; }
  .field input::placeholder { color: var(--haze); }
  .key { display: flex; align-items: center; gap: .5rem; margin: 0 0 1.2rem; font: italic 400 .9rem var(--display); color: var(--haze); }
  .key i { display: inline-block; flex: none; }
  .k-ribbon { width: 6px; height: 14px; background: #a8322f; clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%); }
  .k-slip { width: 9px; height: 12px; background: #f1e7cf; box-shadow: 0 0 0 1px rgba(0,0,0,.2); margin-left: .8rem; transform: rotate(4deg); }

  /* ---------- The bookcase ---------- */
  .case {
    --row: 10.6rem; --plank: 15px;
    --grain: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='600' height='300'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.006 0.22' numOctaves='3' seed='7'/><feColorMatrix values='0 0 0 0 0.12 0 0 0 0 0.06 0 0 0 0 0.02 0 0 0 0.6 0'/></filter><rect width='100%' height='100%' filter='url(%23g)'/></svg>");
    position: relative; padding: 14px 16px 0; border-radius: 6px 6px 3px 3px;
    background: var(--grain), linear-gradient(90deg, #3b2414, #5c3a21 5%, #4b2e1a 50%, #5c3a21 95%, #3b2414);
    box-shadow: 0 2.2rem 3rem -1.6rem rgba(25, 12, 4, .65), inset 0 2px 0 rgba(255, 214, 160, .18), inset 0 -3px 0 rgba(0, 0, 0, .3);
  }
  /* crown moulding along the top */
  .case::before { content: ""; position: absolute; left: -8px; right: -8px; top: -14px; height: 16px; border-radius: 4px 4px 2px 2px; background: var(--grain), linear-gradient(180deg, #7a4f2e, #563620 60%, #3a2414); box-shadow: 0 4px 6px -2px rgba(0,0,0,.45); }
  /* plinth at the bottom */
  .case::after { content: ""; display: block; height: 18px; margin: 0 -16px; border-radius: 0 0 3px 3px; background: var(--grain), linear-gradient(180deg, #2e1b0e, #4a2e1a 30%, #3a2414); }
  .case :global(.bay) { position: relative; }
  /* the shelf label: a little brass plate screwed to the plank above each shelf */
  .case :global(.plate-row) { display: flex; justify-content: center; padding: 6px 0 7px; margin: 0 -16px; background: var(--grain), linear-gradient(180deg, #8a5a35, #6c4428 25%, #573620 80%, #3a2414); box-shadow: 0 6px 10px -4px rgba(0,0,0,.6); position: relative; z-index: 2; }
  .case :global(.bay:first-child .plate-row) { margin-top: -14px; }
  .case :global(.plate) {
    display: inline-flex; align-items: baseline; gap: .6rem; padding: .22rem .9rem .2rem; border-radius: 2px;
    background: linear-gradient(180deg, #e9cf8e, #c49a4c 45%, #a57b33 55%, #d8b46a); color: #3a2611;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.55), inset 0 -1px 0 rgba(0,0,0,.25), 0 1px 2px rgba(0,0,0,.5);
    font: 600 .72rem/1.2 var(--display); letter-spacing: .08em; text-transform: uppercase; position: relative;
  }
  .case :global(.plate::before), .case :global(.plate::after) { content: ""; position: absolute; top: 50%; width: 4px; height: 4px; margin-top: -2px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #f6e2ac, #7a5522); }
  .case :global(.plate::before) { left: 4px; } .case :global(.plate::after) { right: 4px; }
  .case :global(.plate small) { font: 500 .6rem var(--ui); letter-spacing: .14em; opacity: .75; }

  /* books stand in rows; each row's plank and shadow repeat down the bay */
  .case :global(.row) {
    display: flex; flex-wrap: wrap; align-content: flex-start; column-gap: 1px; padding: 0 6px;
    background:
      repeating-linear-gradient(180deg,
        transparent 0 calc(var(--row) - var(--plank)),
        #8a5a35 calc(var(--row) - var(--plank)), #74492a calc(var(--row) - var(--plank) + 3px),
        #5b3920 calc(var(--row) - 5px), #2e1b0e calc(var(--row) - 1px), transparent var(--row)),
      repeating-linear-gradient(180deg, rgba(0,0,0,.5) 0, rgba(0,0,0,0) 26px, transparent var(--row)),
      linear-gradient(90deg, rgba(0,0,0,.45), rgba(0,0,0,0) 6%, rgba(0,0,0,0) 94%, rgba(0,0,0,.45)),
      var(--grain),
      linear-gradient(180deg, #2a190d, #22140a);
  }
  .case :global(.slot) { height: var(--row); padding-bottom: var(--plank); display: flex; align-items: flex-end; }

  /* the tarot bookend leaning at the start of each shelf */
  .case :global(.bookend) { position: relative; margin: 0 .55rem 0 .2rem; align-self: flex-end; }
  .case :global(.bookend img) { display: block; width: 4.3rem; height: auto; aspect-ratio: 3 / 5; border-radius: 3px; transform: rotate(-7deg) translateX(-2px); transform-origin: 100% 100%; box-shadow: 2px 0 0 #e8e0cc, 4px 4px 8px rgba(0,0,0,.6); }

  /* spines */
  .case :global(.spine) {
    flex: none; width: var(--w); height: var(--h); position: relative; cursor: pointer; border: 0; padding: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: space-between;
    color: var(--ink-s, #ecd9a8); border-radius: 2px 2px 1px 1px;
    background:
      linear-gradient(90deg, rgba(0,0,0,.42) 0%, rgba(255,255,255,.14) 16%, rgba(255,255,255,.04) 34%, rgba(0,0,0,.06) 66%, rgba(0,0,0,.45) 100%),
      var(--grain),
      var(--c);
    background-size: auto, 300px 150px, auto;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.12), 0 0 0 .5px rgba(0,0,0,.35);
    transform-origin: 50% 100%; transition: transform .45s cubic-bezier(.2, .8, .2, 1.1), filter .3s;
  }
  .case :global(.spine:hover), .case :global(.spine:focus-visible) { transform: translateY(-.45rem); filter: brightness(1.12); outline: none; }
  .case :global(.spine:focus-visible) { box-shadow: 0 0 0 2px #e9cf8e; }
  .case :global(.spine.lean) { transform: rotate(-4deg); margin: 0 .35rem 0 .15rem; }
  .case :global(.spine.lean:hover) { transform: rotate(-4deg) translateY(-.45rem); }
  .case :global(.spine.out) { transform: translateY(-1.1rem); filter: brightness(1.2); }
  /* gilt bands near head and foot (some books) */
  .case :global(.spine.bands::before), .case :global(.spine.bands::after) { content: ""; position: absolute; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, #8a6a2c, #e5c77c 40%, #8a6a2c); opacity: .85; box-shadow: 0 4px 0 -1px rgba(229,199,124,.55); }
  .case :global(.spine.bands::before) { top: 7%; } .case :global(.spine.bands::after) { bottom: 9%; box-shadow: 0 -4px 0 -1px rgba(229,199,124,.55); }
  /* a dark leather title label (other books) */
  .case :global(.spine .lab) { position: absolute; left: 12%; right: 12%; top: 18%; bottom: 26%; background: rgba(20, 10, 4, .55); box-shadow: inset 0 0 0 1px rgba(229,199,124,.5); border-radius: 1px; }
  .case :global(.t), .case :global(.a) { position: relative; writing-mode: vertical-rl; transform: rotate(180deg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .case :global(.t) { margin-top: 16%; max-height: 62%; font: 500 .78rem/1 var(--display); letter-spacing: .02em; text-shadow: 0 1px 0 rgba(0,0,0,.45); }
  .case :global(.spine.caps .t) { font: 600 .56rem/1 var(--ui); letter-spacing: .16em; text-transform: uppercase; }
  .case :global(.a) { margin-bottom: 8%; max-height: 16%; font: 500 .44rem/1 var(--ui); letter-spacing: .12em; text-transform: uppercase; opacity: .75; }
  /* reading now: a ribbon hanging from the top; up next: a paper slip tucked in */
  .case :global(.spine.reading .mark) { position: absolute; top: -9px; left: 34%; width: 5px; height: 18px; background: #a8322f; clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%); box-shadow: 0 0 2px rgba(0,0,0,.4); }
  .case :global(.spine.next .mark) { position: absolute; top: -12px; left: 18%; width: 64%; height: 20px; background: linear-gradient(180deg, #f6eedb, #e6dabd); transform: rotate(4deg); box-shadow: 0 1px 2px rgba(0,0,0,.35); }

  .empty { margin: 1rem 0 0; font: italic 400 1.1rem var(--display); color: var(--haze); }

  /* ---------- A book taken down ---------- */
  .detail { width: min(54rem, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); padding: 0; border: 0; border-radius: 10px; background: transparent; overflow: visible; color: #2b2530; }
  .detail::backdrop { background: rgba(24, 14, 8, .55); backdrop-filter: blur(4px); }
  .detail[open] { animation: rise .45s cubic-bezier(.2, .8, .2, 1); }
  .sheet {
    position: relative; display: grid; grid-template-columns: 17rem minmax(0, 1fr); gap: 2rem; align-items: center;
    padding: 2rem 2.2rem; border-radius: 10px; max-height: calc(100dvh - 2rem); overflow: auto;
    background: radial-gradient(120% 90% at 30% 20%, #fbf6ec, #efe5d2); box-shadow: 0 2rem 4rem -1rem rgba(20, 10, 4, .6), inset 0 0 0 1px rgba(140, 108, 53, .35);
  }
  .x { position: absolute; top: .6rem; right: .8rem; width: 2.2rem; height: 2.2rem; border: 0; border-radius: 50%; background: none; font: 300 1.6rem/1 var(--ui); color: #6a6370; cursor: pointer; }
  .x:hover { background: rgba(140, 108, 53, .12); color: #2b2530; }

  .stage { perspective: 1100px; display: grid; place-items: center; min-height: 19rem; }
  .book3d {
    --W: 11rem; --H: 16.5rem; --D: 2.3rem;
    position: relative; width: var(--W); height: var(--H); transform-style: preserve-3d;
    transform: rotateY(var(--ry, -26deg)) rotateX(var(--rx, 5deg));
    animation: takedown .9s cubic-bezier(.2, .85, .25, 1.1);
  }
  .book3d .f { position: absolute; backface-visibility: hidden; }
  .book3d .front { inset: 0; transform: translateZ(calc(var(--D) / 2)); border-radius: 0 3px 3px 0; overflow: hidden; }
  .book3d .back { inset: 0; transform: rotateY(180deg) translateZ(calc(var(--D) / 2)); background: var(--cloth); border-radius: 3px 0 0 3px; }
  .book3d .spine3 {
    top: 0; height: 100%; width: var(--D); left: calc((var(--W) - var(--D)) / 2); transform: rotateY(-90deg) translateZ(calc(var(--W) / 2));
    background: linear-gradient(90deg, rgba(0,0,0,.4), rgba(255,255,255,.12) 40%, rgba(0,0,0,.35)), var(--cloth);
    display: grid; place-items: center; color: #ecd9a8;
  }
  .book3d .spine3 span { writing-mode: vertical-rl; transform: rotate(180deg); font: 500 .8rem var(--display); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-height: 80%; }
  .book3d .pages {
    top: 2px; height: calc(100% - 4px); width: calc(var(--D) - 4px); left: calc((var(--W) - var(--D)) / 2 + 2px); transform: rotateY(90deg) translateZ(calc(var(--W) / 2 - 3px));
    background: repeating-linear-gradient(90deg, #f3ead8 0 1px, #e2d6bd 1px 2px), #efe6d2;
  }
  .book3d .top { left: 0; width: calc(100% - 3px); height: var(--D); top: calc((var(--H) - var(--D)) / 2); transform: rotateX(90deg) translateZ(calc(var(--H) / 2)); background: repeating-linear-gradient(0deg, #f3ead8 0 1px, #e2d6bd 1px 2px); }
  .cover {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .6rem; padding: 1.4rem 1.2rem; text-align: center; color: #ecd9a8;
    background:
      repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, rgba(0,0,0,.05) 0 1px, transparent 1px 3px),
      linear-gradient(90deg, rgba(0,0,0,.4), rgba(0,0,0,0) 8%, rgba(255,255,255,.07) 10%, rgba(0,0,0,0) 13%),
      var(--cloth);
    box-shadow: inset 0 0 0 .55rem var(--cloth), inset 0 0 0 calc(.55rem + 1px) #c9a865, inset 0 0 0 calc(.8rem + 1px) var(--cloth), inset 0 0 0 calc(.8rem + 2px) rgba(201, 168, 101, .6);
  }
  .cover b { font: italic 400 1.35rem/1.15 var(--display); text-wrap: balance; text-shadow: 0 1px 0 rgba(0,0,0,.4); }
  .cover em { font: 500 .58rem var(--ui); letter-spacing: .2em; text-transform: uppercase; font-style: normal; }
  .cover .rule { width: 30%; height: 1px; background: currentColor; opacity: .7; }
  .cover .orn { width: 1.6rem; height: 1.6rem; border-radius: 50%; box-shadow: inset 0 0 0 1px currentColor; position: relative; }
  .cover .orn::after { content: ""; position: absolute; inset: 22%; border-radius: 50%; box-shadow: inset -.35rem .05rem 0 0 currentColor; }

  .info { min-width: 0; display: grid; gap: .55rem; align-content: start; }
  .shelfline { margin: 0; display: flex; align-items: center; gap: .7rem; }
  .shelfline img { width: 2.4rem; height: auto; aspect-ratio: 3 / 5; border-radius: 3px; box-shadow: 0 0 0 1px #c9a865, 0 4px 8px -3px rgba(0,0,0,.4); transform: rotate(-4deg); }
  .shelfline span { display: grid; }
  .shelfline b { font: 500 .66rem var(--ui); letter-spacing: .2em; text-transform: uppercase; color: #8c6c35; }
  .shelfline em { font: italic 400 .9rem var(--display); color: #6a6370; }
  .info h2 { margin: .4rem 0 0; font: italic 400 clamp(1.8rem, 3.4vw, 2.6rem)/1.05 var(--display); text-wrap: balance; }
  .author { margin: 0; font-size: .95rem; color: #5b5560; }
  .chip { justify-self: start; margin: .2rem 0 .3rem; padding: .25rem .7rem; border-radius: 99px; background: rgba(140, 108, 53, .14); color: #6d5328; font: 500 .68rem var(--ui); letter-spacing: .12em; text-transform: uppercase; }
  .about { margin: 0; font: 400 1.12rem/1.6 var(--display); max-width: 36em; }
  .detail blockquote { margin: .4rem 0 0; padding-left: 1rem; border-left: 1px solid #c9a865; font: italic 400 1.15rem/1.5 var(--display); color: #5b5560; }
  .note { margin: 0; color: #3d3640; }
  .nav { display: flex; gap: 1.2rem; margin-top: .8rem; padding-top: .9rem; border-top: 1px solid rgba(140, 108, 53, .3); }
  .nav button { background: none; border: 0; padding: .2rem 0; cursor: pointer; color: #6a6370; font: 400 .72rem var(--ui); letter-spacing: .16em; text-transform: uppercase; }
  .nav button:hover { color: #2b2530; }
  .nav button:disabled { opacity: .35; cursor: default; }

  .no-js { display: none; }
  :global(html:not(.js)) .no-js { display: grid; gap: 1.6rem; margin-top: 1rem; }
  :global(html:not(.js)) .case, :global(html:not(.js)) .bar, :global(html:not(.js)) .key { display: none; }
  .no-js h2 { font: italic 400 1.4rem var(--display); margin: 0 0 .4rem; }
  .no-js ul { margin: 0; padding-left: 1.1rem; }
  .no-js em { color: var(--haze); font-size: .85em; }

  @keyframes rise { from { opacity: 0; transform: translateY(18px) scale(.98); } }
  @keyframes takedown { from { transform: translateY(-30px) rotateY(-88deg) rotateX(0deg) scale(.8); } }

  @media (max-width: 700px) {
    .case { --row: 9rem; padding-inline: 10px; }
    .case :global(.plate-row), .case::after { margin-inline: -10px; }
    .case :global(.bookend img) { width: 3.5rem; }
    .field input { width: 100%; }
    .sheet { grid-template-columns: 1fr; gap: 1rem; padding: 1.6rem 1.3rem; }
    .stage { min-height: 13rem; }
    .book3d { --W: 7.6rem; --H: 11.4rem; --D: 1.7rem; }
    .cover b { font-size: 1rem; }
  }
</style>

<script>
  import { play } from '../scripts/sound.js';

  type Book = { id: string; title: string; author: string; category: string; status: string; about?: string; note?: string; line?: string; thoughts?: string; year?: string };
  type Shelf = { category: string; card: string; num: string; name: string; shows: string; cloth: [number, number, number] };
  const D = JSON.parse(document.getElementById('books-data')!.textContent!) as {
    books: Book[]; shelves: Shelf[]; filters: { id: string; statuses: string[] }[]; statusText: Record<string, string>; thumbs: string;
  };
  const shelfOf = Object.fromEntries(D.shelves.map((s) => [s.category, s]));
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const kase = $('case'), empty = $('empty'), find = $<HTMLInputElement>('find'), jump = $<HTMLSelectElement>('jump');
  const dialog = $<HTMLDialogElement>('detail');
  const pills = [...document.querySelectorAll<HTMLButtonElement>('.pill')];

  // ---------- How each spine looks: steady per title, varied across the shelf ----------
  const hash = (s: string) => { let h = 0; for (const ch of s) h = (h * 31 + ch.charCodeAt(0)) >>> 0; return h; };
  const narrow = matchMedia('(max-width: 700px)').matches;
  function look(b: Book) {
    const h = hash(b.title), [hue, sat, lig] = shelfOf[b.category].cloth, k = narrow ? .84 : 1;
    // a few spines stray into deep greens, reds and browns, as a real shelf does
    const stray = [[150, 30, 24], [5, 45, 30], [28, 40, 28], [215, 35, 26], [45, 30, 22]][(h >>> 5) % 5];
    const [H, S, L] = (h % 7 === 0) ? stray : [hue + ((h >>> 6) % 21) - 10, sat, lig];
    return {
      height: (7.6 + (h % 7) * .34) * k, width: (1.45 + ((h >>> 3) % 6) * .2 + Math.min(.4, b.title.length / 120)) * k,
      color: `hsl(${H} ${S}% ${L + ((h >>> 9) % 9) - 4}%)`,
      style: (h >>> 11) % 3, // 0 gilt bands, 1 leather label, 2 small caps
      lean: (h >>> 13) % 13 === 0,
    };
  }

  // ---------- Building the shelves ----------
  let filter = 'all', query = '', list: Book[] = [];
  const order: Record<string, number> = { reading: 0, next: 1, read: 2, quit: 3, toread: 4 };
  const el = (tag: string, cls?: string, text?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };

  function render() {
    const st = D.filters.find((f) => f.id === filter)!.statuses, q = query.trim().toLowerCase();
    const shown = D.books.filter((b) => st.includes(b.status) && (!q || `${b.title} ${b.author}`.toLowerCase().includes(q)));
    list = [];
    const bays = D.shelves.map((s) => {
      const here = shown.filter((b) => b.category === s.category).sort((a, b) => order[a.status] - order[b.status]);
      if (!here.length) return null;
      list.push(...here);
      const bay = el('section', 'bay'); bay.dataset.cat = s.category; bay.setAttribute('aria-label', s.category);
      const plateRow = el('div', 'plate-row'), plate = el('span', 'plate', s.category);
      plate.append(el('small', '', String(here.length))); plateRow.append(plate);
      const row = el('div', 'row'); row.setAttribute('role', 'list');
      const end = el('div', 'slot bookend'); end.title = `${s.name}: ${s.shows}`;
      const img = el('img') as HTMLImageElement; img.src = `${D.thumbs}${s.card}.webp`; img.alt = `${s.name}, keeper of this shelf`; img.loading = 'lazy'; img.width = 240; img.height = 400;
      end.append(img); row.append(end);
      here.forEach((b) => {
        const L = look(b), slot = el('div', 'slot'); slot.setAttribute('role', 'listitem');
        const sp = el('button', `spine ${b.status} ${['bands', 'labelled', 'caps'][L.style]}${L.lean ? ' lean' : ''}`) as HTMLButtonElement;
        sp.type = 'button'; sp.dataset.id = b.id;
        sp.style.cssText = `--h:${L.height}rem;--w:${L.width}rem;--c:${L.color}`;
        sp.setAttribute('aria-label', `${b.title} by ${b.author}, ${D.statusText[b.status]}`);
        if (L.style === 1) sp.append(el('span', 'lab'));
        sp.append(el('span', 't', b.title), el('span', 'a', b.author.split(/[&,]/)[0].trim().split(' ').pop() ?? ''));
        if (b.status === 'reading' || b.status === 'next') sp.append(el('span', 'mark'));
        sp.addEventListener('click', () => open(b.id));
        slot.append(sp); row.append(slot);
      });
      bay.append(plateRow, row);
      return bay;
    }).filter(Boolean) as HTMLElement[];
    kase.replaceChildren(...bays);
    kase.hidden = bays.length === 0; empty.hidden = bays.length > 0;
    [...jump.options].forEach((o) => { if (o.value) o.disabled = !bays.some((b) => b.dataset.cat === o.value); });
  }

  pills.forEach((p) => p.addEventListener('click', () => { filter = p.dataset.filter!; pills.forEach((q) => q.setAttribute('aria-checked', String(q === p))); render(); }));
  find.addEventListener('input', () => { query = find.value; render(); });
  jump.addEventListener('change', () => {
    const bay = kase.querySelector<HTMLElement>(`.bay[data-cat="${CSS.escape(jump.value)}"]`);
    bay?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    jump.value = '';
  });

  // ---------- Taking a book down ----------
  let current = -1;
  function open(id: string) {
    const i = list.findIndex((b) => b.id === id); if (i < 0) return;
    const b = list[i], s = shelfOf[b.category];
    kase.querySelectorAll('.spine.out').forEach((e) => e.classList.remove('out'));
    kase.querySelector(`.spine[data-id="${CSS.escape(b.id)}"]`)?.classList.add('out');
    current = i;
    const book = $('d-book');
    book.style.setProperty('--cloth', look(b).color);
    book.style.animation = 'none'; void book.offsetWidth; book.style.animation = '';
    $('d-ctitle').textContent = b.title; $('d-cauthor').textContent = b.author; $('d-stitle').textContent = b.title;
    ($('d-card') as HTMLImageElement).src = `${D.thumbs}${s.card}.webp`;
    $('d-cat').textContent = b.category;
    $('d-keeper').textContent = `Kept by ${s.name}`;
    $('d-title').textContent = b.title;
    $('d-author').textContent = b.author ? `by ${b.author}` : '';
    $('d-status').textContent = b.year && b.status === 'read' ? `Read in ${b.year}` : D.statusText[b.status];
    $('d-about').textContent = b.about || 'No summary yet. Add a description for it in the sheet.';
    const line = $('d-line'); line.hidden = !b.line; line.textContent = b.line ?? '';
    const note = $('d-note'), mine = [b.note, b.thoughts].filter(Boolean).join(' ');
    note.hidden = !mine; note.textContent = mine;
    ($('d-prev') as HTMLButtonElement).disabled = i === 0;
    ($('d-next') as HTMLButtonElement).disabled = i === list.length - 1;
    if (!dialog.open) dialog.showModal();
    play('flick');
  }
  const step = (d: number) => { const b = list[current + d]; if (b) open(b.id); };
  $('d-prev').addEventListener('click', () => step(-1));
  $('d-next').addEventListener('click', () => step(1));
  $('d-close').addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') step(1); if (e.key === 'ArrowLeft') step(-1); });
  dialog.addEventListener('close', () => { kase.querySelectorAll('.spine.out').forEach((e) => e.classList.remove('out')); });

  // the book in your hands turns a little toward the pointer
  const stage = $('d-stage'), held = $('d-book');
  stage.addEventListener('pointermove', (e) => {
    const r = stage.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
    held.style.setProperty('--ry', `${-26 + x * 40}deg`); held.style.setProperty('--rx', `${5 - y * 16}deg`);
  });
  stage.addEventListener('pointerleave', () => { held.style.removeProperty('--ry'); held.style.removeProperty('--rx'); });

  render();
</script>
