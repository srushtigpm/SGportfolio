---
import Room from '../../layouts/Room.astro';
import { getPosts, readingTime, formatDate } from '../../scripts/posts.js';
import { url } from '../../scripts/url.js';
const posts = await getPosts();
---
<Room card="hermit" title="Lantern notes" intro="Thinking things through, alone and out loud." pageTitle="Notes and essays">
  <ol class="notes">
    {posts.map((p, i) => (
      <li style={`--d:${i * 0.08}s`}>
        <a href={url(`blog/${p.id}`)}>
          <span class="meta"><time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time> · {readingTime(p.body)} min read</span>
          <h2>{p.data.title}</h2>
          <p>{p.data.summary}</p>
        </a>
      </li>
    ))}
  </ol>
  {posts.length === 0 && <p class="placeholder-note">No notes yet. Add a Markdown file to src/content/blog/.</p>}
</Room>

<style>
  .notes { list-style: none; margin: 0; padding: 0; max-width: 40rem; display: grid; }
  li { border-top: 1px solid var(--hair); animation: rise .8s cubic-bezier(.2, .7, .2, 1) var(--d) both; }
  li:last-child { border-bottom: 1px solid var(--hair); }
  a { display: grid; gap: .4rem; padding: 1.6rem 0; text-decoration: none; position: relative; }
  a::before { content: ""; position: absolute; left: -1.6rem; top: 2.05rem; width: .5rem; height: .5rem; border-radius: 50%; background: #f2c46b; box-shadow: 0 0 12px 3px rgba(242, 196, 107, .7); opacity: 0; transition: opacity .5s; }
  a:hover::before, a:focus-visible::before { opacity: 1; }
  .meta { font: 500 .66rem var(--ui); letter-spacing: .2em; text-transform: uppercase; color: var(--gilt); }
  h2 { margin: 0; font: italic 400 1.9rem/1.15 var(--display); transition: transform .6s cubic-bezier(.2, .7, .2, 1); }
  a:hover h2 { transform: translateX(.35rem); }
  p { margin: 0; color: var(--haze); }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
</style>
