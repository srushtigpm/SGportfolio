---
import { getCollection } from 'astro:content';
import Room from '../../layouts/Room.astro';
import SuitCard from '../../components/SuitCard.astro';
import { url } from '../../scripts/url.js';
const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const numerals = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
---
<Room card="magician" title="Things I’ve made" intro="Every tool on the table. Each project is a card in its own suit; turn one over for the whole story." wide>
  <ul class="suit">
    {projects.map((p, i) => (
      <li style={`--d:${i * 0.12}s; --r:${(i % 2 ? 1 : -1) * (1 + (i % 3))}deg`}>
        <a class="pcard" href={url(`work/${p.id}`)}>
          <div class="face">
            <SuitCard name={p.data.card?.name ?? p.data.title} numeral={numerals[i] ?? String(i + 1)} emblem={p.data.card?.emblem} sky={p.data.card?.sky} title={p.data.title} />
            <span class="glint" aria-hidden="true"></span>
          </div>
          <div class="cap">
            <h2>{p.data.title}</h2>
            <p class="sum">{p.data.summary}</p>
            <span class="meta">{p.data.role} · {p.data.year}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</Room>

<style>
  .suit { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr)); gap: 2.4rem 1.8rem; }
  .suit li { animation: deal 1s cubic-bezier(.2, .8, .2, 1.05) var(--d) both; }
  .pcard { display: grid; gap: 1.1rem; text-decoration: none; perspective: 900px; }
  .face {
    position: relative; border-radius: 12px; transform: rotate(var(--r)); transform-style: preserve-3d;
    box-shadow: 0 0 0 1px var(--gilt-soft), 0 1.6rem 2.2rem -1.4rem rgba(30, 24, 36, .55), 0 .4rem .8rem -.4rem rgba(30, 24, 36, .3);
    transition: transform .8s cubic-bezier(.2, .8, .2, 1.1), box-shadow .8s; overflow: hidden;
  }
  .glint { position: absolute; inset: 0; background: linear-gradient(115deg, transparent 30%, rgba(255, 252, 240, .55) 45%, transparent 60%); transform: translateX(-120%); transition: transform 1.1s cubic-bezier(.2, .7, .2, 1); mix-blend-mode: soft-light; }
  .pcard:hover .face, .pcard:focus-visible .face { transform: rotate(0deg) translateY(-10px) rotateX(6deg) rotateY(-8deg) scale(1.02); box-shadow: 0 0 0 1px var(--gilt-soft), 0 2.6rem 3rem -1.6rem rgba(30, 24, 36, .6); }
  .pcard:hover .glint { transform: translateX(120%); }
  .cap { display: grid; gap: .3rem; }
  .cap h2 { margin: 0; font: italic 400 1.35rem/1.2 var(--display); }
  .sum { margin: 0; color: var(--haze); font-size: .92rem; }
  .meta { font: 500 .64rem var(--ui); letter-spacing: .2em; text-transform: uppercase; color: var(--gilt); }
  @keyframes deal { from { opacity: 0; transform: translate(-30px, 60px) rotate(-12deg); } }
</style>
